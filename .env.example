# Copy to .env for `docker compose -f compose.prod.yaml up -d`.
# See docs/operations.md for the full variable reference.

# Public origin, exactly as browsers will address it. Used for session
# cookies, Websocket origin checks, and links in verification mail.
CIRCUITGATE_APP_BASE_URL=https://circuitgate.example.edu
CIRCUITGATE_DOMAIN=circuitgate.example.edu

# PostgreSQL (the db service creates this database and user).
CIRCUITGATE_DB_NAME=circuitgate
CIRCUITGATE_DB_USERNAME=circuitgate
CIRCUITGATE_DB_PASSWORD=change-me

# Signs remember-me tokens; generate with `openssl rand -base64 48`.
CIRCUITGATE_REMEMBER_ME_KEY=change-me

# Comma-separated trusted proxy addresses/CIDRs that may set
# X-Forwarded-For. The default covers the Compose bridge network.
CIRCUITGATE_TRUSTED_PROXIES=172.16.0.0/12

# Outgoing mail.
CIRCUITGATE_MAIL_MODE=smtp
CIRCUITGATE_MAIL_FROM=no-reply@circuitgate.example.edu
SPRING_MAIL_HOST=smtp.example.edu
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=apikey
SPRING_MAIL_PASSWORD=change-me
SPRING_MAIL_SMTP_AUTH=true
SPRING_MAIL_STARTTLS=true
